@page "/"

@implements IAsyncDisposable

<PageTitle>Home</PageTitle>


@if (SystemMessageFromHubServer is null)
{
    <UserInfoComponent eventCallback="ProvideUserInfoToHubServer" />
}
else
{
    <h1>@SystemMessageFromHubServer</h1>
    
    <div class="row">
        <div class="col-4">
            <GroupChatComponent _connectedUsers="_connectedUsers"
                              UserId="@UserId"
                              eventCallback="SelectUser"/>
        </div>
        <div class="col-8">
            <ChatComponent fromUserId="@UserId"
                           ToUser="@TargetUser"
                           connectedUsers="_connectedUsers"/>
        </div>
    </div>
    
    
}




@code{
    private HubConnection? _hubConnection;
    private string? SystemMessageFromHubServer;
    private List<ConnectedUser>? _connectedUsers;
    private string? UserId = string.Empty;
    private ConnectedUser? TargetUser{ set; get; }
    protected override async Task OnInitializedAsync()
    {
        // await ConnectionToHubServer();
    }

    private async Task ConnectionToHubServer(string userName, string userId)
    {
        _hubConnection = new HubConnectionBuilder()
                .WithUrl($"https://localhost:7096/chathub?username={userName}"+$"&userid={userId}")
                .Build();
        _hubConnection.On<string,string>("SystemMessage", HandleSystemMessage);
        _hubConnection.On<List<ConnectedUser>>("UpdateListConnectedUsers", HandleUpdateList);
        await _hubConnection.StartAsync();
        await base.OnInitializedAsync();

    }

    private void HandleUpdateList(List<ConnectedUser> updateConectedUserslist)
    {
        _connectedUsers = updateConectedUserslist;
        InvokeAsync(StateHasChanged);
    }

    private async Task ProvideUserInfoToHubServer(string userName)
    {
        var userId = Guid.NewGuid().ToString();
        await ConnectionToHubServer(userName,userId);
    }

    private void HandleSystemMessage(string obj, string userId)
    {
        SystemMessageFromHubServer = obj;
        UserId = userId;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if(_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private void SelectUser(ConnectedUser user)
    {
        TargetUser = user;
        // Console.WriteLine(TargetUser.UserName);
    }
}
