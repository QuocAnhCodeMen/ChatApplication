@code{
    private HubConnection? _hubConnection;
    private string? SystemMessageFromHubServer;
    private List<ConnectedUser> _connectedUsers = new();
    private string? UserId = string.Empty;
    private ConnectedUser? TargetUser{ set; get; }
    protected override async Task OnInitializedAsync()
    {
        // await ConnectionToHubServer();
    }

    private async Task ConnectionToHubServer(string userName, string userId)
    {
        _hubConnection = new HubConnectionBuilder()
                .WithUrl($"https://localhost:7096/chathub?username={userName}"+$"&userid={userId}")
                .Build();
        _hubConnection.On<string,string>("SystemMessage", HandleSystemMessage);
        _hubConnection.On<List<ConnectedUser>>("UpdateListConnectedUsers", HandleUpdateList);
        _hubConnection.On<string, string>("RecieveMessage", HandleRecieveMessage);
        await _hubConnection.StartAsync();
        await base.OnInitializedAsync();

    }

    private void HandleRecieveMessage(string fromUserId, string message)
    {
        Console.WriteLine("UserID " + fromUserId);
        var user = _connectedUsers?.FirstOrDefault(u => u.UserId == fromUserId);
        Console.WriteLine("Name:" + user?.UserName);
        if(user is not null)
        {
            var chatMessage = new ChatMessage()
                {
                    Message = message,
                    FromUserId = fromUserId,
                    ToUserId = UserId
                };
            user.Messages.Add(chatMessage);
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandleUpdateList(List<ConnectedUser> updateUserslist)
    {
        if (_connectedUsers.Count == 0)
        {
            _connectedUsers = updateUserslist;
        }
        else
        {
            var existingUsersDictionary = _connectedUsers
                    .ToDictionary(u => u.ConnectedId??string.Empty);
            foreach (var user in updateUserslist)
            {
                
                   if (!existingUsersDictionary.ContainsKey(user.ConnectedId ?? string.Empty))
                    {
                        _connectedUsers.Add(user);
                    }
                

            }
            _connectedUsers = _connectedUsers
                            .Where(u => updateUserslist.Any(newUser => newUser.ConnectedId == u.ConnectedId))
                            .ToList();
        }
     
        InvokeAsync(StateHasChanged);
    }

    private async Task ProvideUserInfoToHubServer(string userName)
    {
        var userId = Guid.NewGuid().ToString();
        await ConnectionToHubServer(userName,userId);
    }

    private void HandleSystemMessage(string obj, string userId)
    {
        SystemMessageFromHubServer = obj;
        UserId = userId;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if(_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private void SelectUser(ConnectedUser user)
    {
        TargetUser = user;
        // Console.WriteLine(TargetUser.UserName);
    }
}
