@page "/"
@layout EmptyLayout
@implements IAsyncDisposable

<PageTitle>ChatApplication</PageTitle>
@if (SystemMessageFromHubServer is null)
{
    <UserInfoComponent eventCallback="ProvideUserInfoToHubServer" />
}
else
{
    <div class="container-fluid p-0 d-flex vh-100">
        <div class="chat-sidebar d-flex flex-column">
            <GroupChatComponent _connectedUsers="_connectedUsers"
                                UserId="@UserId"
                                eventCallback="SelectUser" />
        </div>
        <div class="flex-grow-1 bg-black">
            <ChatComponent fromUserId="@UserId"
                           ToUser="@TargetUser"
                           connectedUsers="_connectedUsers"
                           hubConnection="_hubConnection" />
        </div>

    </div>
}




<style>
    .chat-sidebar{
        min-width:220px;
        width:300px;
       
    }
</style>


