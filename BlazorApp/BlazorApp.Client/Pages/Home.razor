@page "/"
@implements IAsyncDisposable

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>
@if (SystemMessageFromHubServer is not null)
{
    @SystemMessageFromHubServer
}
<UserInfoComponent eventCallback="ProvideUserInfoToHubServer" />



@code{
    private HubConnection? _hubConnection;
    private string? SystemMessageFromHubServer;

    protected override async Task OnInitializedAsync()
    {
        // await ConnectionToHubServer();
    }

    private async Task ConnectionToHubServer(string userName)
    {
        _hubConnection = new HubConnectionBuilder()
                .WithUrl($"https://localhost:7096/chathub?username={userName}")
                .Build();
        _hubConnection.On<string>("SystemMessage", HandleSystemMessage);
        await _hubConnection.StartAsync();
        await base.OnInitializedAsync();

    }
    private async Task ProvideUserInfoToHubServer(string userName)
    {
        await ConnectionToHubServer(userName);
    }

    private void HandleSystemMessage(string obj)
    {
        SystemMessageFromHubServer = obj;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if(_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }


}
