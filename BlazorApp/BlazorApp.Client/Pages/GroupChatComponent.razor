<h3>=================GroupChatComponent=====================</h3>
@if(_connectedUsers is null || _connectedUsers.Count <=0)
{
    <h3>GroupChat hiện không có thành viên nào</h3>
}
else
{
    <ul class="list-group">
        @foreach (var user in _connectedUsers)
        {
            if (!string.IsNullOrEmpty(UserId))
            {
                if (user.UserId != UserId)
                {
                    <li @onclick="()=>SelectUser(user)" class="list-group-item">@user.UserName</li>
                }
            }

            
        }
       
    </ul>

}


@code {
    [Parameter]
    public List<ConnectedUser>? _connectedUsers { set; get; }
    [Parameter]
    public string? UserId { set; get; }
    [Parameter]
    public EventCallback<ConnectedUser> eventCallback { set; get; }

    private void SelectUser(ConnectedUser user)
    {
        eventCallback.InvokeAsync(user);
    }
}
