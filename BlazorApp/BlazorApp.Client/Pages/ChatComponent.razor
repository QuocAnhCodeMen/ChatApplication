

 <div class="d-flex flex-column vh-100">
        @* Header *@
        
        <div class="p-3 text-center border-bottom">
            <strong style="font-size:20px">@(ToUser is null?"Click One In The SideBar To Start The Chat":ToUser.UserName)</strong>
        </div>

        @* Body *@
        <div class="p-3 flex-grow-1 overflow-y-auto d-flex flex-column gap-2">
            @foreach(var message in ToUser?.Messages ?? Enumerable.Empty<ChatMessage>())
            {
                if(message.FromUserId == fromUserId)
                {
                    <div class="d-flex justify-content-end">
                        <div class="p-2 text-center  text-white bg-primary rounded-4">
                            @message.Message
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-start">
                        <div class="p-2 text-center  text-black bg-light rounded-4">
                            @message.Message
                        </div>
                    </div>
                }
            }
            
           
        </div>

        @* footer *@
        <div class="d-flex gap-2 algin-items-center">
            <input @onkeydown="(KeyboardEventArgs e) => HandleKeyDown(e)"
                   @bind="newMessage" type="text"
                   @bind:event="oninput"
                   placeholder="Write your Message here....."
                   class="form-control p-2 bg-light border-1"
                   disabled=@(ToUser is not null?false:true) />
            <button disabled=@(ToUser is not null?false:true) 
                    @onclick="Send" 
                    class="btn btn-primary">Send</button>
        </div>

 </div>

@code {

    [Parameter]
    public string? fromUserId { set; get; }

    [Parameter]
    public ConnectedUser? ToUser { set; get; }
    [Parameter]
    public List<ConnectedUser>? connectedUsers { set; get; }

    [Parameter]
    public HubConnection? hubConnection { set; get; }


    private string? newMessage;



    private void Send()
    {
        var chatMessage = new ChatMessage()
            {
                FromUserId = fromUserId,
                ToUserId = ToUser?.UserId,
                Message = newMessage

            };


        hubConnection?
            .InvokeAsync("ForwarMessage", ToUser?.ConnectedId, fromUserId, newMessage);
        chatMessage.Unread = false;
        ToUser?.Messages.Add(chatMessage);
        newMessage = string.Empty;



    }



    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if(e.Key == "Enter")
        {
            Send();
        }
    }
}
