
@if(fromUserId is not null && 
ToUser is not null && 
connectedUsers is not null && 
connectedUsers.Count > 0)
{

    <div class="card">
        <ul class="list-group list-group-flush">
            
            
                @foreach (var message in ToUser.Messages)
                {
                    <li class="list-group-item">

                        <h5 class="card-title">QA Coder</h5>
                        <p class="card-text"><i>@message.Message</i></p>
                    </li>
                }
         
        </ul>
        <div class="card-footer d-flex align-items-start">
            <input 
                @onkeydown="(KeyboardEventArgs e)=>HandleKeyDown(e)" 
                @bind="newMessage" type="text"
                @bind:event="oninput"
                placeholder="Write your Message here....." />
            <button @onclick="Send" class="btn btn-primary" style="margin:5px">Send</button>
        </div>
    </div>
}





@code {

    [Parameter]
    public string? fromUserId { set; get; }

    [Parameter]
    public ConnectedUser? ToUser { set; get; }
    [Parameter]
    public List<ConnectedUser>? connectedUsers { set; get; }

    [Parameter]
    public HubConnection? hubConnection { set; get; }


    private string? newMessage;



    private void Send()
    {
        var chatMessage = new ChatMessage()
            {
                FromUserId = fromUserId,
                ToUserId = ToUser?.UserId,
                Message = newMessage

            };


        hubConnection?
            .InvokeAsync("ForwarMessage", ToUser?.ConnectedId, fromUserId, newMessage);
        chatMessage.Unread = false;
        ToUser?.Messages.Add(chatMessage);
        newMessage = string.Empty;



    }



    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if(e.Key == "Enter")
        {
            Send();
        }
    }
}
